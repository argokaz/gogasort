{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "site",
  "headers": [
    { "source": "/(img|fonts)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(proart|descargar/.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
